# macOS
.DS_Store

# Xcode project is generated by XcodeGen from project.yml
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved files are committed: they pin exact dependency versions.

# Sample exports from other apps (may hold host details)
*.rtsz
*.rtsx


# Signing material and secrets: never committed. Release tooling reads the
# signing identity and notarization login from the Keychain.
*.cer
*.p12
*.p8
*.pem
*.key
*.mobileprovision
*.provisionprofile
.env
.env.*

# Local logs and databases
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal

# AI coding assistant instructions and local settings: personal, not shipped
CLAUDE.md
CLAUDE.md.*
CLAUDE.local.md
.claude/
AGENTS.md
GEMINI.md
.mcp.json
.cursor/
.cursorrules
.windsurfrules
.codex/
.aider*
.github/copilot-instructions.md
